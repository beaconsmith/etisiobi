# Research Spine — Environment Variables
# Copy to .env and fill in values
# Never commit .env to git

# Oroma DB connection (read-only user)
# Create with: CREATE USER research_reader WITH PASSWORD '...'; GRANT SELECT ON ALL TABLES IN SCHEMA public TO research_reader;
OROMA_DB_URL=postgresql://research_reader:password@localhost:5432/oroma

# Workspace IDs to extract (comma-separated, or 'all' for all active workspaces)
WORKSPACE_IDS=all

# Path to etisiobi repo root
ETISIOBI_PATH=/path/to/etisiobi

# Measurement window in days (default: 90)
MEASUREMENT_DAYS=90
