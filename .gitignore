# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Data & Downloads — DON'T commit large files to git
sources/papers/
*.pdf
*.epub
*.mobi

# Migrated source material (binary files — too large for git)
research/icegov/sources/kb/
research/icegov/sources/methods_docs/
research/icegov/sources/papers_raw/
research/icegov/sources/reports/

# Obsidian cache
.obsidian/workspace
.obsidian/workspace.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Local provider/session config must not define the public research protocol
.claude/

# Downloader logs / manifest (optional — you may want to commit manifest)
sources/downloader.log

# Research build/scratch artifacts
research/**/*.aux
research/**/*.out
research/**/*.toc
research/**/*.synctex.gz
research/icegov/paper/*.log
research/icegov/paper/temp_*.tex
research/icegov/paper/test_*.tex
research/icegov/paper/diff.txt

# External audit worktrees are read-only scratch clones; keep only metadata and reports.
external_audits/**/repos/

# OS
.DS_Store
Thumbs.db

# Venv / IDE
.venv/
venv/
.env
.env.*
!.env.example
!.env.*.example
.vscode/
*.swp

# Frontend dependencies and build output
node_modules/
.next/

# Research Spine
spine/.env
research/icegov/facts/*.json
